{
  "name": "openaquarium",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.2.19",
  "overrides": {
    "esbuild": "0.27.4"
  },
  "scripts": {
    "dev": "bun ./node_modules/vite/bin/vite.js --configLoader native",
    "server": "bun ./src/server/index.ts",
    "dev:server": "bun --watch ./src/server/index.ts",
    "cleanup:state": "bun ./src/server/cleanup-state.ts",
    "cli": "bun ./src/cli/main.ts",
    "build": "tsc --noEmit -p tsconfig.app.json && bun ./node_modules/vite/bin/vite.js build --configLoader native",
    "preview": "bun ./node_modules/vite/bin/vite.js preview --configLoader native",
    "lint": "eslint .",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node ./node_modules/vitest/vitest.mjs",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "check": "bun run lint && bun run test && bun run build && bun run typecheck:server"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.15.0",
    "@ai-sdk/mcp": "^1.0.25",
    "@ai-sdk/openai-compatible": "^2.0.35",
    "@ai-sdk/react": "^3.0.118",
    "@fontsource-variable/geist": "^5.2.8",
    "@mcpc-tech/acp-ai-provider": "^0.2.4",
    "@streamdown/cjk": "^1.0.2",
    "@streamdown/code": "^1.1.0",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.166.3",
    "@tanstack/react-virtual": "^3.13.23",
    "@xyflow/react": "^12.10.1",
    "ai": "^6.0.116",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-hierarchy": "^3.1.2",
    "flexlayout-react": "^0.8.19",
    "katex": "^0.16.38",
    "lucide-react": "^0.577.0",
    "prismjs": "^1.30.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-simple-code-editor": "^0.14.1",
    "remark-breaks": "^4.0.0",
    "shadcn": "^4.0.2",
    "sonner": "^2.0.7",
    "streamdown": "^2.4.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.19.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitejs/plugin-react": "6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "esbuild": "0.27.4",
    "eslint": "^10.0.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "happy-dom": "^20.8.3",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "8.0.0",
    "vitest": "^4.0.18"
  }
}
